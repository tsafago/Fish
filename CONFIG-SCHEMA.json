  "layoutGrammar": {
    "leaf": "L|{pane-uuid}|{profile-uuid}",
    "ratio": "finite 0.05..0.95",
    "shape": "1 full; 2 horizontal; 3 large left with vertically stacked right; 4-8 two rows, ceil(count/2) above. Each row is a right-nested horizontal chain.",
    "split": "H|{ratio}|{first}|{second} or V|{ratio}|{first}|{second}"
  },
  "maxBytes": 2000000,
  "metadata": {
    "config.baseRevision": {
      "constraints": "Required export revision; never edit it. Apply/validate require a matching, closed workspace.",
      "default": null,
      "type": "sha256-or-absent"
    },
    "config.format": {
      "constraints": "Exact case-sensitive value.",
      "default": "1",
      "type": "enum",
      "values": [
        "1"
      ]
    }
  },
  "profileFields": {
    "auto": {
      "constraints": "Explicit opt-in RFC 4777 plain automatic sign-on. Independent login requires username. False when linked.",
      "default": false,
      "type": "boolean"
    },
    "codePage": {
      "constraints": "Exact case-sensitive value.",
      "default": "37",
      "type": "enum",
      "values": [
        "37",
        "273",
        "277",
        "278",
        "280",
        "284",
        "285",
        "297",
        "500",
        "870",
        "871",
        "1140",
        "1141",
        "1147",
        "1148"
      ]
    },
    "device": {
      "constraints": "Empty or [A-Z#$@][A-Z0-9_#$@]{0,9}; canonicalized uppercase.",
      "default": "",
      "type": "ibmi-name"
    },
    "effect": {
      "constraints": "Exact case-sensitive value.",
      "default": "None",
      "type": "enum",
      "values": [
        "None",
        "Soft glow",
        "Prism",
        "Flux (animated)"
      ]
    },
    "host": {
      "constraints": "0..253 characters, no whitespace/control characters. Empty is offline/unconfigured.",
      "default": "",
